# Cloudflare static-assets redirects (GitHub Pages ignores this file).
# Chỉ dùng path tương đối: redirect cấp domain (http → https, www → non-www)
# cấu hình trong Cloudflare dashboard (Always Use HTTPS + Redirect Rules).
# Không thêm rule "/x → /x.html": html_handling mặc định của Cloudflare
# tự 307 /x.html → /x nên sẽ tạo vòng lặp redirect.
/index.html / 301

# GitHub Pages không đọc _redirects. URL không đuôi .html dùng
# tin-tuc/<slug>/index.html — sinh bằng: npm run generate-tin-tuc-clean-urls
/tin-tuc /tin-tuc/ 301
/tin-tuc/index.html /tin-tuc/ 301
/blog /tin-tuc/ 301
/blog/ /tin-tuc/ 301
/blog.html /tin-tuc/ 301
/news /tin-tuc/ 301
/news/ /tin-tuc/ 301

# Trang tạo QR: alias cũ → /qr-code/
/qrcode.html /qr-code/ 301
/qrcode /qr-code/ 301
/lich-am-hom-nay.html /lich-am-hom-nay 301

# Lịch âm dương = Lịch vạn niên (cùng 1 trang)
/lich-am-duong /lich-van-nien.html 301
/lich-am-duong.html /lich-van-nien.html 301

# Alias URL sai thư mục → trang đúng
/tin-tuc/cua-hang.html /cua-hang.html 301
/lich-tet-2026.html /lich-tet-2027.html 301
/lich-nghi-tet-2026.html /lich-nghi-tet-2027.html 301
